# Supabase — proyecto compartido con KCC Marine Cloud
# Ver lib/supabase/README.md
NEXT_PUBLIC_SUPABASE_URL=https://zxgeipuzglromtuxhxtb.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Mux — video (ver lib/mux/client.ts)
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=

# Upstash — rate limiting (ver lib/upstash/ratelimit.ts)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Sanity — Sprint 5. Sin NEXT_PUBLIC_SANITY_PROJECT_ID configurado,
# cada página cae automáticamente al catálogo temporal (lib/data/*.ts) —
# el sitio nunca se ve en blanco, solo deja de reflejar cambios hechos
# en Sanity hasta que esto se configure.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Requiere permiso de lectura de BORRADORES (no solo "Viewer" de
# contenido publicado) — sin esto, Visual Editing / Presentation no
# puede mostrar cambios sin publicar. Se genera en
# sanity.io/manage → tu proyecto → API → Tokens → "Editor" o superior.
SANITY_API_READ_TOKEN=

# Contacto — sin esto, los canales correspondientes se ocultan en /contact
# (nunca se muestra un dato de contacto inventado). Ver lib/config/contact.ts
NEXT_PUBLIC_CONTACT_WHATSAPP=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_EMAIL=

# Marine Cloud integration — DEJAR EN false hasta que exista una
# implementación real de MarineCloudIntegration. Ver
# lib/integrations/marine-cloud/client.ts
MARINE_CLOUD_INTEGRATION_ENABLED=false
